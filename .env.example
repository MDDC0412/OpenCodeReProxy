# Published image tag; replace to select another release.
OPENCODE2API_VERSION=v1.3.7-secdev-diagnostics

# Host ports mapped to the container's 8080 and 8081 listeners.
OPENCODE2API_PORT=8080
OPENCODE2API_WEBUI_PORT=8081

# Container listeners must accept connections through published ports.
OPENCODE2API_LISTEN=0.0.0.0:8080
OPENCODE2API_WEBUI_LISTEN=0.0.0.0:8081
